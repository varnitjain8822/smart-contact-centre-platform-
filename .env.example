# Copy to .env (or run `node scripts/init-env.mjs`, which also creates chatwoot/.env).
# CHATWOOT_* ids/tokens/secrets are written by `node scripts/chatwoot-setup.mjs`.

# Compose profile used by plain `docker compose` commands: dev | prod (make up / make prod set it explicitly)
COMPOSE_PROFILES=dev

# --- mongo auth (generated; compose builds the api MONGO_URL from MONGO_APP_PASSWORD) ---
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# --- api ---
PORT=4000
# host-run api only; in compose MONGO_URL is set with the app user's credentials
MONGO_URL=mongodb://mongo:27017/smartcc
MONGO_MEMORY=0
JWT_SECRET=
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=1
CHATWOOT_URL=http://rails:3000
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_ADMIN_TOKEN=
CHATWOOT_BOT_TOKEN=
CHATWOOT_INBOX_SECRET=
CHATWOOT_BOT_SECRET=
CHATWOOT_TIMEOUT_MS=10000
GROQ_API_KEY=
GROQ_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_MS=20000
AI_AUTO_THRESHOLD=0.85
AI_DRAFT_THRESHOLD=0.60
AI_MAX_AUTO_REPLIES=2
SLA_AT_RISK_RATIO=0.25
SYNC_INTERVAL_MS=30000
WEBHOOK_TOLERANCE_S=300
LOG_LEVEL=info
# uploads (compose mounts the `uploads` volume here)
UPLOAD_DIR=/data/uploads
# email: dev compose forces smtp://mailhog:1025; prod uses this value (e.g. smtp://user:pass@smtp.example.com:587); empty = no email
SMTP_URL=
MAIL_FROM="SmartCC Support <support@smartcc.localhost>"
# links in emails; compose sets it per profile (dev http://localhost:$WEB_PORT, prod https://smartcc.localhost)
PUBLIC_URL=http://localhost:5173
UNSUBSCRIBE_SECRET=
# api drains SSE connections this long on SIGTERM (compose stop_grace_period is 15s)
SHUTDOWN_GRACE_MS=10000

# --- setup only (scripts/chatwoot-setup.mjs) ---
CW_ADMIN_EMAIL=portal-service@smartcc.test
CW_ADMIN_PASSWORD=
CW_AGENT_EMAIL=agent@smartcc.test
CW_AGENT_PASSWORD=
PORTAL_INTERNAL_URL=http://api:4000

# Host ports (change if 3000/5173 are taken)
CW_PORT=3000
WEB_PORT=5173
# prod profile: Caddy host ports (bound to 127.0.0.1). The public URLs assume 443.
HTTPS_PORT=443
HTTP_PORT=80

# --- v3 (all optional) ---
# WhatsApp Cloud API inbox, created by scripts/chatwoot-setup.mjs when all four are set. PHONE_NUMBER is the E.164 display number.
WHATSAPP_PHONE_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_KEY=
# SMS sign-in codes: msg91 | twilio (empty = phone option hidden). msg91 needs a DLT template with an ##otp## variable.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# KB embeddings: model id or `off` (text-only search). Compose caches the model in the `models` volume (EMBED_CACHE_DIR=/data/models).
EMBED_MODEL=
EMBED_CACHE_DIR=
